{
  "name": "crewly-app",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "The Crewly web app. Talks to any Crewly server over the vendored SDK.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "vendor:check": "node scripts/vendor.mjs --check",
    "vendor:sync": "node scripts/vendor.mjs",
    "smoke:hosted": "node scripts/smoke-hosted.mjs"
  },
  "dependencies": {
    "@blobatar/react": "^2.7.0",
    "@vitejs/plugin-react": "^6.1.1",
    "blobatar": "^2.7.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  },
  "vendor": [
    {
      "owner": "crewly-server",
      "from": "../server/src/protocol",
      "to": "src/protocol"
    },
    {
      "owner": "crewly-server",
      "from": "../server/src/sdk",
      "to": "src/sdk"
    }
  ]
}
